{
  "name": "portfolio-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web制作会社のコーダー職応募用ポートフォリオサイト",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:js": "eslint src scripts",
    "format": "prettier --write \"**/*.{html,scss,js,json,md}\"",
    "capture": "node scripts/capture-screenshots.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.5"
  }
}
